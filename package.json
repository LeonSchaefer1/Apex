{
  "name": "anwaltapex",
  "private": true,
  "version": "0.9.0",
  "description": "AnwaltApex – das Kanzlei-Betriebssystem für deutsche Rechtsanwälte",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:demo": "VITE_APP_MODE=demo VITE_ROUTER=memory vite build --outDir dist-demo",
    "build:static": "VITE_APP_MODE=demo VITE_ROUTER=hash vite build --outDir dist-static --base ./",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/index.js --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "start": "node --no-warnings=ExperimentalWarning dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/core/core.test.ts src/ai/analyse.test.ts",
    "build:artifact": "npm run build:demo && node scripts/build-artifact.mjs dist-demo dist-artifact/anwaltapex.html"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@hono/node-server": "1.19.17",
    "@tanstack/react-table": "8.21.3",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "hono": "4.13.13",
    "idb-keyval": "6.3.0",
    "lucide-react": "0.577.0",
    "motion": "12.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.25.12",
    "playwright": "1.56.1",
    "tailwindcss": "4.1.18",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}