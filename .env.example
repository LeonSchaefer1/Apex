# AnwaltApex Server-Konfiguration
PORT=8787
# Pfad zur SQLite-Datenbank (wird automatisch angelegt)
DATABASE_PATH=./data/anwaltapex.db
# Zugang zur Apex Console (Anbieter-Verwaltung aller Kunden-Kanzleien) – ohne Passwort ist die Console deaktiviert
CONSOLE_ADMIN_EMAIL=admin@anwaltapex.de
CONSOLE_ADMIN_PASSWORD=bitte-ein-langes-passwort-setzen
# Optional: Claude-API-Schlüssel für Live-KI. Ohne Schlüssel läuft die KI im Demo-Modus.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Demo-Kanzleien beim ersten Start anlegen und Schnell-Login-Karten anzeigen (für Präsentationen)
SEED_DEMO=true
DEMO_QUICK_LOGIN=true
# Hinter HTTPS (z. B. Render, Reverse Proxy) auf true setzen
COOKIE_SECURE=false
