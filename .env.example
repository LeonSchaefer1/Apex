# AnwaltApex Server-Konfiguration
PORT=8787
# Pfad zur SQLite-Datenbank (wird automatisch angelegt)
DATABASE_PATH=./data/anwaltapex.db
# Geheimnis für Sitzungs-Cookies (bitte lang & zufällig wählen)
SESSION_SECRET=bitte-aendern
# Zugang zur Apex Console (Anbieter-Verwaltung aller Kunden-Kanzleien)
CONSOLE_ADMIN_EMAIL=admin@anwaltapex.de
CONSOLE_ADMIN_PASSWORD=bitte-aendern
# Optional: Claude-API-Schlüssel für Live-KI. Ohne Schlüssel läuft die KI im Demo-Modus.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Schnell-Login-Karten auf der Anmeldeseite anzeigen (nur für Präsentationen)
DEMO_QUICK_LOGIN=true
