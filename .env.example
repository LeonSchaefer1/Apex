# Apex – Server-Konfiguration
PORT=8787
# Pfad zur SQLite-Datenbank (wird automatisch angelegt; Dateiname aus der Zeit vor der Umbenennung in Apex)
DATABASE_PATH=./data/anwaltapex.db
# Zugang zur Apex Console (Anbieter-Verwaltung aller Kunden-Kanzleien). Ohne Passwort, mit diesem Platzhalter,
# mit öffentlich bekannten Demo-Passwörtern oder mit weniger als 12 Zeichen bleibt die Console deaktiviert.
CONSOLE_ADMIN_EMAIL=admin@apex-kanzlei.de
CONSOLE_ADMIN_PASSWORD=bitte-ein-langes-passwort-setzen
# Optional: Claude-API-Schlüssel für Live-KI. Ohne Schlüssel läuft die KI im Demo-Modus.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Live-KI auch für die eingebauten Präsentationskanzleien (deren Zugangsdaten öffentlich sind)? on | off
AI_DEMO_TENANTS=on
# Höchstlänge einer KI-Antwort (Tokens, inkl. Denkanteil) und Tageskontingente (0 = unbegrenzt)
AI_MAX_TOKENS=16000
AI_DAILY_REQUESTS_PER_TENANT=400
AI_DAILY_TOKENS_PER_TENANT=3000000
AI_DAILY_TOKENS_TOTAL=15000000
# Demo-Kanzleien beim ersten Start anlegen und Schnell-Login-Karten anzeigen (für Präsentationen)
SEED_DEMO=true
DEMO_QUICK_LOGIN=true
# Hinter HTTPS (z. B. Render, Reverse Proxy) auf true setzen – dann auch mit HSTS
COOKIE_SECURE=false
# Nur hinter einem eigenen Reverse Proxy auf true setzen: Client-IP aus dem letzten X-Forwarded-For-Eintrag
TRUST_PROXY=false
# Zeitzone für „heute“, Fristen und den Tageswechsel der Beispieldaten
TZ=Europe/Berlin
